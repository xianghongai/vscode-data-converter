{
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"insertFinalNewline": true,
	"printWidth": 120,
	"proseWrap": "preserve",
	"quoteProps": "as-needed",
	"semi": true,
	"singleQuote": true,
	"sortPackageJson": false,
	"tabWidth": 2,
	"trailingComma": "es5",
	"useTabs": false,
	"ignorePatterns": ["dist/**", "node_modules/**", "pnpm-lock.yaml", "LICENSE"],
	"overrides": [
		{
			"files": ["*.json"],
			"options": {
				"useTabs": true
			}
		}
	]
}
